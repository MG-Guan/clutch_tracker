#!/usr/bin/env python3
"""
Standalone CLI launcher installed to .venv/bin/clutch-tracker.

Bootstraps src/ without relying on .pth hooks (fixes conda + venv issues).
"""

from __future__ import annotations

import json
import sys
from pathlib import Path


def _repo_src() -> Path | None:
    """Locate src/ containing the clutch_tracker package."""
    cwd = Path.cwd()
    if (cwd / "src" / "clutch_tracker").is_dir():
        return cwd / "src"

    for entry in sys.path:
        if not entry:
            continue
        base = Path(entry)
        if (base / "clutch_tracker").is_dir() and base.name == "src":
            return base
        if (base / "src" / "clutch_tracker").is_dir():
            return base / "src"

    for entry in sys.path:
        if not entry:
            continue
        sp = Path(entry)
        if not sp.is_dir():
            continue
        for meta in sp.glob("clutch_tracker*.dist-info"):
            direct = meta / "direct_url.json"
            if not direct.exists():
                continue
            data = json.loads(direct.read_text(encoding="utf-8"))
            url = data.get("url", "")
            if url.startswith("file:"):
                root = Path(url[5:])
                src = root / "src"
                if (src / "clutch_tracker").is_dir():
                    return src
    return None


def _main() -> int:
    src = _repo_src()
    if src is None:
        print(
            "ERROR: Cannot locate clutch_tracker. "
            "Run from the repo root, or use: python run.py <command>",
            file=sys.stderr,
        )
        return 1

    src_str = str(src)
    if src_str not in sys.path:
        sys.path.insert(0, src_str)

    from clutch_tracker.cli import main

    return main()


if __name__ == "__main__":
    raise SystemExit(_main())
