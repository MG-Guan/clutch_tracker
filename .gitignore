__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.env
*.log
.DS_Store

# Local content database (never commit vehicle history)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Legacy file storage / generated artifacts (keep structure only)
data/raw_scans/*
!data/raw_scans/.gitkeep
data/targets/*/
!data/targets/.gitkeep
data/registry/*
!data/registry/.gitkeep
reports/daily/*/
!reports/daily/.gitkeep
reports/recommendations/*/
!reports/recommendations/.gitkeep
reports/summary/*
!reports/summary/.gitkeep
snapshots/*/
!snapshots/.gitkeep
